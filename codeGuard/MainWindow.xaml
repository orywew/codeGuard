<Window x:Class="codeGuard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="codeGuard"
        Height="760"
        Width="1250"
        MinHeight="680"
        MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Background="#080B0D"
        FontFamily="Consolas">

    <Window.Resources>

        <SolidColorBrush x:Key="Onyx" Color="#080B0D"/>
        <SolidColorBrush x:Key="Panel" Color="#151A1E"/>
        <SolidColorBrush x:Key="Input" Color="#20262B"/>
        <SolidColorBrush x:Key="Silver" Color="#D5D9DB"/>
        <SolidColorBrush x:Key="Muted" Color="#92999E"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#41494F"/>

        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Background" Value="#20262B"/>
            <Setter Property="Foreground" Value="#F0F0F0"/>
            <Setter Property="BorderBrush" Value="#41494F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>

        <Style x:Key="PasswordInput" TargetType="PasswordBox">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Background" Value="#20262B"/>
            <Setter Property="Foreground" Value="#F0F0F0"/>
            <Setter Property="BorderBrush" Value="#41494F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="49"/>
            <Setter Property="Background" Value="#252B30"/>
            <Setter Property="Foreground" Value="#E3E6E8"/>
            <Setter Property="BorderBrush" Value="#626B71"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#D5D9DB"/>
                                <Setter Property="Foreground" Value="#080B0D"/>
                                <Setter Property="BorderBrush" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineButton" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Background" Value="#171C20"/>
            <Setter Property="Foreground" Value="#D5D9DB"/>
            <Setter Property="BorderBrush" Value="#41494F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#D5D9DB"/>
                                <Setter Property="Foreground" Value="#080B0D"/>
                                <Setter Property="BorderBrush" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D5D9DB"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AEB5B9"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#07090B" Offset="0"/>
                <GradientStop Color="#11171B" Offset="0.5"/>
                <GradientStop Color="#080B0D" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Subtle monochrome background lighting -->
        <Ellipse Width="500"
                 Height="500"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 Margin="-250,-270,0,0"
                 Fill="#657078"
                 Opacity="0.055">
            <Ellipse.Effect>
                <BlurEffect Radius="110"/>
            </Ellipse.Effect>
        </Ellipse>

        <Ellipse Width="550"
                 Height="550"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Bottom"
                 Margin="0,0,-270,-280"
                 Fill="#879197"
                 Opacity="0.045">
            <Ellipse.Effect>
                <BlurEffect Radius="120"/>
            </Ellipse.Effect>
        </Ellipse>

        <Grid Margin="55">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="0.9*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT BRANDING -->
            <Grid Grid.Column="0" Margin="0,0,35,0">

                <StackPanel VerticalAlignment="Center">

                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,48">

                        <Border Width="43"
                                Height="43"
                                Background="#D5D9DB">

                            <TextBlock Text="C"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       Foreground="#080B0D"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="codeGuard"
                                   FontSize="27"
                                   FontWeight="Bold"
                                   Foreground="#F0F0F0"
                                   VerticalAlignment="Center"
                                   Margin="14,0,0,0"/>
                    </StackPanel>

                    <TextBlock Text="SECURE YOUR&#10;SOFTWARE ECOSYSTEM."
                               FontSize="37"
                               FontWeight="Bold"
                               Foreground="White"
                               FontFamily="Consolas"
                               LineHeight="46"/>

                    <Border Width="75"
                            Height="3"
                            Background="#8D969C"
                            HorizontalAlignment="Left"
                            Margin="0,27,0,25"/>

                    <TextBlock Text="Track vulnerabilities. Monitor dependencies.&#10;Protect every project from potential threats."
                               FontSize="14"
                               Foreground="#AAB1B5"
                               LineHeight="26"/>

                    <StackPanel Margin="0,55,0,0">

                        <TextBlock Text="SYSTEM OVERVIEW"
                                   FontSize="11"
                                   Foreground="#D5D9DB"
                                   Margin="0,0,0,20"/>

                        <TextBlock Text="01  /  Vulnerability monitoring"
                                   Foreground="#AAB1B5"
                                   FontSize="12"
                                   Margin="0,0,0,15"/>

                        <TextBlock Text="02  /  Dependency tracking"
                                   Foreground="#AAB1B5"
                                   FontSize="12"
                                   Margin="0,0,0,15"/>

                        <TextBlock Text="03  /  Risk assessment"
                                   Foreground="#AAB1B5"
                                   FontSize="12"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="CODEGUARD  /  SOFTWARE SECURITY"
                           FontSize="10"
                           Foreground="#697278"
                           VerticalAlignment="Bottom"/>
            </Grid>

            <!-- RIGHT AUTHENTICATION PANEL -->
            <Border Grid.Column="1"
                    Background="#D910151A"
                    BorderBrush="#41494F"
                    BorderThickness="1"
                    Padding="45">

                <Grid>

                    <!-- LOGIN PANEL -->
                    <StackPanel x:Name="LoginPanel"
                                VerticalAlignment="Center">

                        <TextBlock Text="WELCOME BACK"
                                   FontSize="11"
                                   Foreground="#C3C9CC"
                                   Margin="0,0,0,16"/>

                        <TextBlock Text="Sign in to your account"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="Enter your credentials to access codeGuard."
                                   FontSize="12"
                                   Foreground="#92999E"
                                   Margin="0,10,0,32"/>

                        <TextBlock Text="EMAIL ADDRESS"
                                   Style="{StaticResource FieldLabel}"
                                   Margin="0,0,0,9"/>

                        <TextBox x:Name="LoginEmail"
                                 Style="{StaticResource InputBox}"
                                 Margin="0,0,0,22"/>

                        <Grid Margin="0,0,0,9">
                            <TextBlock Text="PASSWORD"
                                       Style="{StaticResource FieldLabel}"/>

                            <Button Content="Forgot password?"
                                    Style="{StaticResource LinkButton}"
                                    HorizontalAlignment="Right"
                                    Padding="0"
                                    Click="ForgotPassword_Click"/>
                        </Grid>

                        <PasswordBox x:Name="LoginPassword"
                                     Style="{StaticResource PasswordInput}"
                                     Margin="0,0,0,25"/>

                        <Button Content="SIGN IN"
                                Style="{StaticResource PrimaryButton}"
                                Click="Login_Click"/>

                        <TextBlock Text="OR CONTINUE WITH"
                                   Foreground="#92999E"
                                   FontSize="10"
                                   HorizontalAlignment="Center"
                                   Margin="0,25,0,18"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Content="Google"
                                    Style="{StaticResource OutlineButton}"
                                    Click="Google_Click"/>

                            <Button Grid.Column="2"
                                    Content="GitHub"
                                    Style="{StaticResource OutlineButton}"
                                    Click="Github_Click"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,28,0,0">

                            <TextBlock Text="New to codeGuard?"
                                       Foreground="#92999E"
                                       FontSize="12"/>

                            <Button Content="Create account"
                                    Style="{StaticResource LinkButton}"
                                    Click="ShowSignup_Click"
                                    Margin="5,0,0,0"
                                    Padding="0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- SIGNUP PANEL -->
                    <StackPanel x:Name="SignupPanel"
                                Visibility="Collapsed"
                                VerticalAlignment="Center">

                        <TextBlock Text="GET STARTED"
                                   FontSize="11"
                                   Foreground="#C3C9CC"
                                   Margin="0,0,0,16"/>

                        <TextBlock Text="Create your account"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="Set up your codeGuard account."
                                   FontSize="12"
                                   Foreground="#92999E"
                                   Margin="0,10,0,25"/>

                        <TextBlock Text="FULL NAME"
                                   Style="{StaticResource FieldLabel}"
                                   Margin="0,0,0,9"/>

                        <TextBox x:Name="SignupName"
                                 Style="{StaticResource InputBox}"
                                 Margin="0,0,0,17"/>

                        <TextBlock Text="EMAIL ADDRESS"
                                   Style="{StaticResource FieldLabel}"
                                   Margin="0,0,0,9"/>

                        <TextBox x:Name="SignupEmail"
                                 Style="{StaticResource InputBox}"
                                 Margin="0,0,0,17"/>

                        <TextBlock Text="PASSWORD"
                                   Style="{StaticResource FieldLabel}"
                                   Margin="0,0,0,9"/>

                        <PasswordBox x:Name="SignupPassword"
                                     Style="{StaticResource PasswordInput}"
                                     Margin="0,0,0,23"/>

                        <Button Content="CREATE ACCOUNT"
                                Style="{StaticResource PrimaryButton}"
                                Click="Signup_Click"/>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,25,0,0">

                            <TextBlock Text="Already have an account?"
                                       Foreground="#92999E"
                                       FontSize="12"/>

                            <Button Content="Sign in"
                                    Style="{StaticResource LinkButton}"
                                    Click="ShowLogin_Click"
                                    Margin="5,0,0,0"
                                    Padding="0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- FORGOT PASSWORD PANEL -->
                    <StackPanel x:Name="ForgotPanel"
                                Visibility="Collapsed"
                                VerticalAlignment="Center">

                        <TextBlock Text="ACCOUNT RECOVERY"
                                   FontSize="11"
                                   Foreground="#C3C9CC"
                                   Margin="0,0,0,16"/>

                        <TextBlock Text="Reset your password"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="Enter your registered email address to continue."
                                   FontSize="12"
                                   Foreground="#92999E"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,30"/>

                        <TextBlock Text="EMAIL ADDRESS"
                                   Style="{StaticResource FieldLabel}"
                                   Margin="0,0,0,9"/>

                        <TextBox x:Name="ForgotEmail"
                                 Style="{StaticResource InputBox}"
                                 Margin="0,0,0,24"/>

                        <Button Content="SEND RESET LINK"
                                Style="{StaticResource PrimaryButton}"
                                Click="ResetPassword_Click"/>

                        <Button Content="Back to sign in"
                                Style="{StaticResource LinkButton}"
                                Click="ShowLogin_Click"
                                HorizontalAlignment="Center"
                                Margin="0,25,0,0"/>
                    </StackPanel>

                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
